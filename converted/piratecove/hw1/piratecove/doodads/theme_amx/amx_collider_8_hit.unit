<unit slot="doodad">
  <behavior class="Breakable">
  </behavior>

  <scenes start="hwport_def">
    <scene name="hwport_shared">
      <collision static="true">
        <circle offset="0 0" radius="10" />
      </collision>
    </scene>

    <scene name="closed">
      <data name="health"><int>1000000</int></data>
	  <scene src="hwport_shared" />
      <sprite origin="0 0" looping="true" texture="hw1/piratecove/doodads/theme_amx/amx_ruin.png" material="system/default.mats:doodad">
        <frame>128 110 16 16</frame>
      </sprite>
    </scene>

    <scene name="hwport_def">
      <data name="health"><int>1000000</int></data>
	  <scene src="hwport_shared" />
      <sprite origin="8 8" looping="true" texture="hw1/piratecove/doodads/theme_amx/amx_ruin.png" material="system/default.mats:doodad">
        <frame>32 0 16 16</frame>
      </sprite>
    </scene>

  </scenes>

</unit>
