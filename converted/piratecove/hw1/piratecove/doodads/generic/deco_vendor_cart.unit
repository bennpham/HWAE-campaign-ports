<unit slot="doodad">

  <scenes start="hwport_def">
    <scene name="hwport_shared">
      <collision static="true">
        <polygon>
          <point>-6 -10</point>
          <point>-6 0</point>
          <point>6 -10</point>
          <point>6 0</point>
        </polygon>
      </collision>
    </scene>

    <scene name="hwport_def">
	  <scene src="hwport_shared" />
      <sprite origin="6 13" looping="true" texture="hw1/piratecove/doodads/generic/deco_vendor_props.png" material="system/default.mats:proj-prop">
        <frame>0 0 15 13</frame>
      </sprite>
    </scene>

  </scenes>

</unit>
