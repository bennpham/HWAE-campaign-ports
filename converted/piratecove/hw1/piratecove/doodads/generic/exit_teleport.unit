<unit slot="doodad">

  <behavior class="StateAnimations">
    <string name="default">open</string>
    <array name="transitions">
    </array>
  </behavior>
  <scenes start="open">
    <scene name="hwport_shared">
      <collision static="true">
        <polygon>
          <point>-10 8</point>
          <point>-10 0</point>
          <point>-8 0</point>
          <point>-8 8</point>
        </polygon>
        <polygon>
          <point>8 8</point>
          <point>8 0</point>
          <point>10 0</point>
          <point>10 8</point>
        </polygon>
      </collision>
    </scene>

    <scene name="open">
	  <scene src="hwport_shared" />
      <sprite origin="10 34" looping="true" texture="hw1/piratecove/doodads/generic/exit_teleport.png" material="system/default.mats:doodad">
        <frame time="150">20 0 20 42</frame>
        <frame time="150">40 0 20 42</frame>
        <frame time="150">60 0 20 42</frame>
        <frame time="150">80 0 20 42</frame>
      </sprite>
      <sprite origin="10 34" looping="true" texture="hw1/piratecove/doodads/generic/exit_teleport.png" material="system/default.mats:glow">
        <frame time="150">20 59 20 42</frame>
        <frame time="150">40 59 20 42</frame>
        <frame time="150">60 59 20 42</frame>
        <frame time="150">80 59 20 42</frame>
      </sprite>
    </scene>

    <scene name="closed">
	  <scene src="hwport_shared" />
      <sprite origin="10 34" looping="true" texture="hw1/piratecove/doodads/generic/exit_teleport.png" material="system/default.mats:doodad">
        <frame time="100">0 0 20 42</frame>
      </sprite>
    </scene>

    <scene name="destroyed">
	  <scene src="hwport_shared" />
      <sprite origin="10 34" looping="true" texture="hw1/piratecove/doodads/generic/exit_teleport.png" material="system/default.mats:doodad">
        <frame time="100">100 0 20 42</frame>
      </sprite>
    </scene>

  </scenes>

</unit>
