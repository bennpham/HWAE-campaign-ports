<unit slot="doodad">

  <scenes start="hwport_def">
    <scene name="hwport_shared">
      <collision static="true">
        <polygon>
          <point>0 16</point>
          <point>0 -24</point>
          <point>16 -24</point>
          <point>16 16</point>
        </polygon>
      </collision>
      <shadow darkness="1.0">
        <polygon>
          <point>0 0</point>
          <point>16 0</point>
          <point>16 16</point>
          <point>0 16</point>
        </polygon>
      </shadow>
    </scene>

    <scene name="hwport_def">
	  <scene src="hwport_shared" />
      <sprite origin="0 32" looping="true" texture="hw1/piratecove/doodads/theme_a/a.png" material="system/default.mats:proj-wall">
        <frame>16 128 16 48</frame>
      </sprite>
    </scene>

  </scenes>

</unit>
