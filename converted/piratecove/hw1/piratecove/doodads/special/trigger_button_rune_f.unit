<unit slot="doodad" layer="-20">

  <behavior class="StateAnimations">
    <string name="default">deactivate</string>
    <array name="transitions">
    </array>
  </behavior>
  <scenes start="deactivate">
    <scene name="hwport_shared">
    </scene>

    <scene name="activate">
	  <scene src="hwport_shared" />
      <sprite origin="0 0" looping="true" texture="hw1/piratecove/doodads/special/trigger_button.png" material="system/default.mats:doodad">
        <frame>112 48 16 16</frame>
      </sprite>
      <sprite origin="0 0" looping="true" texture="hw1/piratecove/doodads/special/trigger_button.png" material="system/default.mats:glow">
        <frame>64 16 16 16</frame>
      </sprite>
    </scene>

    <scene name="deactivate">
	  <scene src="hwport_shared" />
      <sprite origin="0 0" looping="true" texture="hw1/piratecove/doodads/special/trigger_button.png" material="system/default.mats:doodad">
        <frame>96 48 16 16</frame>
      </sprite>
    </scene>

  </scenes>

</unit>
